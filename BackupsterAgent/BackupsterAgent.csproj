<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BackupsterAgent</RootNamespace>
    <AssemblyName>BackupsterAgent</AssemblyName>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <Version>1.5.1</Version>
    <InformationalVersion>1.5.1</InformationalVersion>
    <UserSecretsId>682cede7-c276-4c32-a9ba-2eb01fa9759a</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="4.0.102.5" />
    <PackageReference Include="AWSSDK.SecretsManager" Version="4.*" />
    <PackageReference Include="AWSSDK.SimpleSystemsManagement" Version="4.*" />
    <PackageReference Include="Azure.Identity" Version="1.*" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.*" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.29.2" />
    <PackageReference Include="Google.Cloud.SecretManager.V1" Version="2.*" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.6" />
    <PackageReference Include="Microsoft.SqlServer.DacFx" Version="170.*" />
    <PackageReference Include="MongoDB.Driver" Version="3.*" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <PackageReference Include="NCrontab" Version="3.*" />
    <PackageReference Include="Polly" Version="8.*" />
    <PackageReference Include="SSH.NET" Version="2025.1.0" />
  </ItemGroup>

  <PropertyGroup>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
  </PropertyGroup>

  <!-- Microsoft.Data.SqlClient requires ICU; bundle it app-local so the self-contained
       linux package works on hosts without libicu. Version must match the package pin. -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64' or '$(RuntimeIdentifier)' == 'linux-arm64'">
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.11" />
    <PackageReference Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3" />
    <RuntimeHostConfigurationOption Include="System.Globalization.AppLocalIcu" Value="72.1.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- appsettings.json lives at the repo root; link it into the output directory -->
    <Content Include="..\appsettings.json" CopyToOutputDirectory="Always" Link="appsettings.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BackupsterAgent.Tests" />
    <InternalsVisibleTo Include="BackupsterAgent.IntegrationTests" />
  </ItemGroup>

</Project>
